<!DOCTYPE html>
<style>
    body {
        background-color: #fffbf5;
        margin: 0;
    }
    .topnav {
        top: 0;
        font-family: Tahoma, sans-serif;
        width : 100%;
        height: 10%;
        position: fixed;
    }
    .title {
        font-size: 50px;
        margin-top: 20px;
        margin-left: 20px;
        float: left;
        color: #241b14
    }
    .signup {
        text-align: center;
        align-content: center;
        margin-top: 20px;
        margin-right: 20px;
        float: right;
        font-size: 20px;
        border-radius: 30px;
        width: 100px;
        height: 40px;
        background-color: #ddcfc1;
        transition-duration: 0.2s;
    }
    .signup:hover {
        transition-duration: 0.2s;
        background-color: #b68760;
        cursor: pointer;
    }
    .slogan {
        font-family: Georgia;
        font-size: 100px;
        position: relative;
        top: 120px;
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
    }
    .desc {
        font-family: Arial;
        position: relative;
        font-size: 20px;
        font-style: italic;
        top: 40px;
        text-align: center;
    }
</style>
<html>
    <body>
        
        <div class="topnav">
            <h1 class="title">SKINIC</h1>
            <a class="signup">Sign up</a>
        </div>
        <p class="slogan">Match your taste to your race.</p>
        <p class="desc">Swipe, match, and see the music your race takes you.</p>
    </body>
</html>
