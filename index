<!DOCTYPE html>

<style>
    body {
        background-color: #fffbf5;
        margin: 0;
    }
    .topnav {
        background-color: #fffbf5;
        top: 0;
        font-family: Tahoma, sans-serif;
        width : 100%;
        height: 10%;
        position: fixed;
        z-index: 100;
    }
    .title {
        font-size: 50px;
        margin-top: 20px;
        margin-left: 20px;
        float: left;
        color: #241b14
    }
    .login {
        text-align: center;
        align-content: center;
        margin-top: 20px;
        margin-right: 20px;
        float: right;
        font-size: 20px;
        border-radius: 30px;
        width: 100px;
        height: 40px;
        background-color: #ddcfc1;
        transition-duration: 0.2s;
    }
    .login:hover {
        transition-duration: 0.2s;
        background-color: #b68760;
        cursor: pointer;
    }
    .slogan {
        font-family: Georgia;
        font-size: 100px;
        position: relative;
        top: 150px;
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
    }
    .desc {
        font-family: Arial;
        position: relative;
        font-size: 20px;
        font-style: italic;
        top: 70px;
        text-align: center;
    }
    .signup {
        margin: 0 auto;
        margin-top: 100px;
        font-family: arial;
        text-align: center;
        align-content: center;
        font-size: 20px;
        border-radius: 20px;
        width: 200px;
        height: 40px;
        background-color: #ddcfc1;
        transition-duration: 0.2s;
    }
    .signup:hover {
        transition-duration: 0.2s;
        background-color: #b68760;
        cursor: pointer;
    }
    .div2 {
        margin-top: 550px;
        width: 100%;
        height: 500px;
        background-color: #b68760;
        font-family: arial;
    }
    @keyframes appear {
        from {
            top: 130px;
            opacity: 0;
        }
        to {
            top: 70px;
            opacity: 1;
        }
    }
   .newplaylist {
        font-family: georgia;
        position: relative;
        top: 130px;
        color: #fffbf5;
        font-size: 40px;
        text-align: center;
        opacity: 0;
    }
    
    .newplaylist.animate {
        animation: appear 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>
<html>
    <body>
        
        <div class="topnav">
            <h1 class="title">SKINIC</h1>
            <a class="login">Log in</a>
        </div>
        <p class="slogan">Match your taste to your race.</p>
        <p class="desc">Swipe, match, and see the music your race takes you.</p>
        <p class="signup">Create an account</p>
        <div class="div2">
            <p class="newplaylist">Your new playlist is just a swipe away.</p>
            <p></p>
            <img src="images\index\blackguy.jpg" alt="blackguy">
        </div>
       <script>
            const element = document.querySelector(".newplaylist");
        
            const observer = new IntersectionObserver((entries) => {
                if (entries[0].isIntersecting) {
                    element.classList.add("animate");
                } else {
                    element.classList.remove("animate");
                }
            });
        
            observer.observe(element);
        </script>
    </body>
</html>
